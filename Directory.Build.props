<Project>

  <PropertyGroup>
    <!-- Target frameworks shared by the projects. The Windows SDK suffix matters: SkiaSharp.Views.WPF only ships a
         .NET build for net10.0-windows10.0.19041; plain net10.0-windows silently falls back to its net48 build. -->
    <UrDeckTfm>net10.0</UrDeckTfm>
    <UrDeckWindowsTfm>net10.0-windows10.0.19041.0</UrDeckWindowsTfm>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Required for IDE0005 (unused usings) to run during build; missing-XML-doc warnings stay off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Test projects: xunit v2 on the Windows TFM (they reference WPF-adjacent assemblies) and never packed. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <TargetFramework>$(UrDeckWindowsTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

</Project>
