<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Widgy.Core and SkiaSharp are provided by the host at runtime; don't copy them next to the plugin. -->
    <ProjectReference Include="..\Widgy.Core\Widgy.Core.csproj" Private="false" />
    <ProjectReference Include="..\Widgy.Analyzer\Widgy.Analyzer.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
  </ItemGroup>

</Project>
