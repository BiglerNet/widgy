<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- The Windows SDK version suffix matters: SkiaSharp.Views.WPF only ships a .NET build for
             net10.0-windows10.0.19041; plain net10.0-windows silently falls back to its net48 build. -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
        <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.4" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Widgy.Core\Widgy.Core.csproj" />
        <!-- Build the built-in plugin with the host, but load it from plugins/ at runtime (not referenced). -->
        <ProjectReference Include="..\..\widgets\Widgy.Widgets.Clock\Widgy.Widgets.Clock.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <None Update="widgy-config.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Drop built-in plugin assemblies into $(OutDir)plugins so the host discovers them like any third-party plugin. -->
    <Target Name="CopyBuiltInPlugins" AfterTargets="Build">
        <MSBuild Projects="..\..\widgets\Widgy.Widgets.Clock\Widgy.Widgets.Clock.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_WidgyPluginAssembly" />
        </MSBuild>
        <Copy SourceFiles="@(_WidgyPluginAssembly)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
    </Target>
</Project>
